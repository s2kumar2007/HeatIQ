# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# HEATIQ_BACKEND_URL: The URL of the HeatIQ FastAPI backend.
# server.ts proxies all /api/backend/* calls here.
# Default is local development; change to the deployed backend URL in production.
HEATIQ_BACKEND_URL="http://127.0.0.1:8000"
