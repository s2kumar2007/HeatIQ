# ============================================================
# HeatIQ Backend — Environment Variables
# Copy this file to .env and fill in your actual keys.
# ============================================================

# ----------------------------------------------------------
# Groq LLM API — https://console.groq.com/keys
# Used by the HeatIQ Decision Agent (loop.py) for LLM reasoning.
# ----------------------------------------------------------
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.1-8b-instant

# ----------------------------------------------------------
# FortyGuard Temperature API — https://fortyguard.com/dashboard
# Used to fetch real-time heat data (temperature, heat index, WBGT).
# ----------------------------------------------------------
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=YOUR_FORTYGUARD_API_KEY_HERE

# ----------------------------------------------------------
# Agent Safety Thresholds (°C)
# ----------------------------------------------------------
DEFAULT_SAFE_MAX_C=35
DEFAULT_CAUTION_MAX_C=40

# ----------------------------------------------------------
# Polling (FortyGuard async job polling)
# ----------------------------------------------------------
POLL_INTERVAL_SECONDS=2
POLL_TIMEOUT_SECONDS=30

# ----------------------------------------------------------
# Phase 3 — Alert Webhooks (optional)
# ----------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_TRACKED_LOCATIONS_FILE=app/tracked_locations.json